# Copie para .env e substitua todos os valores. Nunca versione o arquivo .env.
REDAWAY_SECRET_KEY=generate-a-long-random-secret
REDAWAY_DEBUG=0
REDAWAY_ALLOWED_HOSTS=app.seudominio.com
REDAWAY_REGISTRATION_ENABLED=0
REDAWAY_DEFAULT_FROM_EMAIL=RedaWay Academy <nao-responda@seudominio.com>
REDAWAY_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
REDAWAY_EMAIL_HOST=smtp.seu-provedor.com
REDAWAY_EMAIL_PORT=587
REDAWAY_EMAIL_USER=usuario-smtp
REDAWAY_EMAIL_PASSWORD=senha-smtp
REDAWAY_EMAIL_USE_TLS=1
REDAWAY_EMAIL_USE_SSL=0
REDAWAY_DB_NAME=redaway
REDAWAY_DB_USER=redaway
REDAWAY_DB_PASSWORD=use-uma-senha-forte-e-unica
REDAWAY_DB_CONN_MAX_AGE=60

# Para Render + Supabase, prefira DATABASE_URL da conexão Supavisor em modo
# session (porta 5432) e configure também as credenciais S3 do bucket privado.
# Não use a URL direta do Supabase se ela não estiver acessível pela rede IPv4 do Render.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_URL_ENCODED@aws-0-region.pooler.supabase.com:5432/postgres
REDAWAY_STORAGE_BACKEND=supabase_s3
SUPABASE_STORAGE_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=REGIAO_INFORMADA_PELO_SUPABASE
SUPABASE_STORAGE_BUCKET=avatars
SUPABASE_STORAGE_ACCESS_KEY_ID=chave_s3_do_servidor
SUPABASE_STORAGE_SECRET_ACCESS_KEY=segredo_s3_do_servidor
