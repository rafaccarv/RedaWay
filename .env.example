# Local development defaults. The settings module defaults to SQLite and
# prints recovery emails to the development server terminal.
REDAWAY_SECRET_KEY=dev-only-change-me-before-deploy
REDAWAY_DEBUG=1
REDAWAY_ALLOWED_HOSTS=localhost,127.0.0.1
REDAWAY_REGISTRATION_ENABLED=1

# Production only — set real values in the deployment environment.
# REDAWAY_SECRET_KEY=replace-with-a-long-random-secret
# REDAWAY_DEBUG=0
# REDAWAY_ALLOWED_HOSTS=redaway.example.com
# Keep new registrations disabled (0) until privacy and minors safeguards are approved.
# REDAWAY_REGISTRATION_ENABLED=0
# REDAWAY_DEFAULT_FROM_EMAIL=RedaWay Academy <nao-responda@example.com>
# REDAWAY_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# REDAWAY_EMAIL_HOST=smtp.example.com
# REDAWAY_EMAIL_PORT=587
# REDAWAY_EMAIL_USER=your-smtp-user
# REDAWAY_EMAIL_PASSWORD=your-smtp-password
# REDAWAY_EMAIL_USE_TLS=1
# REDAWAY_EMAIL_USE_SSL=0
# REDAWAY_DB_ENGINE=django.db.backends.postgresql
# REDAWAY_DB_NAME=redaway
# REDAWAY_DB_USER=redaway
# REDAWAY_DB_PASSWORD=replace-me
# REDAWAY_DB_HOST=localhost
# REDAWAY_DB_PORT=5432
# REDAWAY_DB_CONN_MAX_AGE=60
# REDAWAY_DB_SSLMODE=require
